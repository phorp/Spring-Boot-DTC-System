<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.ShijiaDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.ShijiaEntity" id="shijiaMap">
        <result property="qichepinpai" column="qichepinpai"/>
        <result property="qichexinghao" column="qichexinghao"/>
        <result property="cheliangtupian" column="cheliangtupian"/>
        <result property="chepaihaoma" column="chepaihaoma"/>
        <result property="yuyueleixing" column="yuyueleixing"/>
        <result property="guzhangmiaoshu" column="guzhangmiaoshu"/>
        <result property="yuyueqingkuang" column="yuyueqingkuang"/>
        <result property="yuyueriqi" column="yuyueriqi"/>
        <result property="shijianduan" column="shijianduan"/>
        <result property="yonghuming" column="yonghuming"/>
        <result property="shouji" column="shouji"/>
        <result property="shhf" column="shhf"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.ShijiaVO" >
		SELECT * FROM shijia  shijia
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.ShijiaVO" >
		SELECT  shijia.* FROM shijia  shijia
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.ShijiaView" >

		SELECT  shijia.* FROM shijia  shijia
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.ShijiaView" >
		SELECT * FROM shijia  shijia <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
